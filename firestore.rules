rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function userToken() {
      return request.auth.token;
    }
    
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function role() {
      return ('role' in userToken() && userToken().role != null)
        ? userToken().role
        : userDoc().role;
    }
    
    function userWorkshopId() {
      return ('workshopId' in userToken() && userToken().workshopId != null)
        ? userToken().workshopId
        : userDoc().workshopId;
    }

    function userSupplierId() {
      return ('supplierId' in userToken() && userToken().supplierId != null)
        ? userToken().supplierId
        : userDoc().supplierId;
    }
    
    function isActive() {
      return isSignedIn() && (!('status' in userToken()) || userToken().status != 'disabled');
    }
    
    function isAdmin() {
      return isActive() && role() == 'admin';
    }
    
    function isOwnerOf(workshopId) {
      return isActive() && role() == 'owner' && (
        userWorkshopId() == workshopId ||
        get(/databases/$(database)/documents/workshops/$(workshopId)).data.ownerUid == request.auth.uid
      );
    }
    
    function isSupplier(supplierId) {
      return isActive() && role() == 'supplier' && userSupplierId() == supplierId;
    }

    // Users collection
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isSignedIn() && (
        isAdmin() || (
          request.auth.uid == uid && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']) ||
            (request.resource.data.role == resource.data.role && request.resource.data.status == resource.data.status)
          )
        )
      );
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read, update, delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if isSignedIn() &&
          request.resource.data.recipientUid == uid &&
          request.resource.data.title is string &&
          request.resource.data.body is string &&
          request.resource.data.isRead is bool;
      }
    }

    // Workshops and their subcollections
    match /workshops/{workshopId} {
      allow read: if isSignedIn();
      allow write: if (
        isActive() && role() == 'owner' && (
          userWorkshopId() == workshopId ||
          resource == null ||
          resource.data.ownerUid == request.auth.uid ||
          request.resource.data.ownerUid == request.auth.uid
        )
      ) || isAdmin();

      match /{subcollection=**} {
        allow read, write: if isOwnerOf(workshopId) || isAdmin();
      }
    }

    // Profile Systems & Calculation Rules
    match /profileSystems/{systemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /calculationRules/{ruleId} {
      // Non-admins can only read approved or archived rules (no drafts)
      allow read: if isSignedIn() && (
        resource.data.status in ['approved', 'archived'] || isAdmin()
      );
      // Admin client writes rules across valid statuses (supports Spark plan without Cloud Functions)
      allow create, update: if isAdmin() && request.resource.data.status in ['draft', 'approved', 'archived'];
      allow delete: if isAdmin() && resource.data.status == 'draft';
    }

    // Platform Configuration (e.g. cutting optimizer global defaults)
    match /systemConfigs/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Catalog items & Glass types
    match /catalogItems/{itemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /glassTypes/{glassId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Suppliers & Supplier subcollections
    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow write: if isSupplier(supplierId) || isAdmin();

      match /prices/{priceId} {
        allow read: if isSignedIn();
        allow write: if isSupplier(supplierId) || isAdmin();

        match /history/{historyId} {
          allow read: if isSignedIn();
          allow write: if isSupplier(supplierId) || isAdmin();
        }
      }

      // Stock and lots are server-only writes (via Cloud Functions transactions)
      match /stock/{itemId} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      match /lots/{lotId} {
        allow read: if isSupplier(supplierId) || isAdmin();
        allow write: if false;
      }
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        isOwnerOf(resource.data.workshopId) ||
        isSupplier(resource.data.supplierId) ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        (isOwnerOf(request.resource.data.workshopId) || isAdmin()) &&
        request.resource.data.status in ['draft', 'sent'];
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          isOwnerOf(resource.data.workshopId) &&
          request.resource.data.workshopId == resource.data.workshopId &&
          resource.data.status in ['draft', 'sent', 'quoted'] &&
          request.resource.data.status in ['draft', 'sent', 'quoted', 'confirmed', 'cancelled']
        ) ||
        (
          isSupplier(resource.data.supplierId) &&
          request.resource.data.supplierId == resource.data.supplierId &&
          request.resource.data.workshopId == resource.data.workshopId &&
          resource.data.status in ['sent', 'quoted', 'confirmed', 'preparing'] &&
          request.resource.data.status in ['sent', 'quoted', 'confirmed', 'preparing', 'completed', 'cancelled'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'items',
            'totalAmount',
            'supplierResponseNote',
            'notes',
            'status',
            'statusHistory',
            'confirmedBy',
            'confirmedAt',
            'updatedAt'
          ])
        )
      );
      allow delete: if isAdmin() || (
        isSignedIn() &&
        isOwnerOf(resource.data.workshopId) &&
        resource.data.status in ['draft', 'sent', 'cancelled']
      );
    }

    // Inventory Movements & Audit Logs are strictly server-side writes
    match /inventoryMovements/{movementId} {
      allow read: if isAdmin() || (isSignedIn() && isSupplier(resource.data.supplierId));
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
